# --- Fintraffic S-124 SECOM service ---
# Direct test service URL from Fintraffic (Ramin). No MSR lookup needed for testing.
SECOM_S124_BASE_URL=

# --- mTLS client identity (MIR-issued cert) ---
# Leave unset while the test service is open. Provide EITHER inline PEM OR a file path.
# SECOM_CLIENT_CERT=
# SECOM_CLIENT_CERT_PATH=./certs/client.pem
# SECOM_CLIENT_KEY=
# SECOM_CLIENT_KEY_PATH=./certs/client.key
# SECOM_CA_CERT=
# SECOM_CA_CERT_PATH=./certs/ca.pem

# Server port (Cloud Run overrides this)
# PORT=8080

# --- AIS relay (aisstream.io → Firestore) ---
# One upstream WebSocket per org with AIS enabled in the app's Admin console.
# Keys are read from Firestore (orgs/{orgId}/secrets/ais) with the Admin SDK —
# none are set here. On Cloud Run the service account supplies credentials;
# locally, point GOOGLE_APPLICATION_CREDENTIALS at a service-account key.
# GOOGLE_APPLICATION_CREDENTIALS=./sa-key.json
# AIS_RELAY_ENABLED=true          # set to false to run the gateway without it
# AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# AIS_POSITION_THROTTLE_MS=8000   # fastest we rewrite one vessel's position
# AIS_STALE_MS=600000             # drop a vessel unheard this long
# AIS_PRUNE_INTERVAL_MS=60000
