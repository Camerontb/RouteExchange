# --- Fintraffic S-124 SECOM service ---
# Direct test service URL from Fintraffic (Ramin). No MSR lookup needed for testing.
SECOM_S124_BASE_URL=

# --- mTLS client identity (MIR-issued cert) ---
# Leave unset while the test service is open. Provide EITHER inline PEM OR a file path.
# SECOM_CLIENT_CERT=
# SECOM_CLIENT_CERT_PATH=./certs/client.pem
# SECOM_CLIENT_KEY=
# SECOM_CLIENT_KEY_PATH=./certs/client.key
# SECOM_CA_CERT=
# SECOM_CA_CERT_PATH=./certs/ca.pem

# Server port (Cloud Run overrides this)
# PORT=8080
