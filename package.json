{
  "name": "empx-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway between EMPX and Fintraffic's Maritime Connectivity Platform (SECOM / S-100).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "undici": "^7.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.0"
  }
}
